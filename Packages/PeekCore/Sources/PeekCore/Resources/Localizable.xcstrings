    "这是分卷的一部分，请预览第一卷 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is part of a multi-volume archive. Preview the first volume, %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是分卷的一部分，请预览第一卷 %@"

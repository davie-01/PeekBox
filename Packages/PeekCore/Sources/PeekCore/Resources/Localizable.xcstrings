{
  "sourceLanguage": "en",
  "strings": {
    "%@（修改前）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (before edit)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（修改前）"
          }
        }
      }
    },
    "上次打开日期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date Last Opened"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次打开日期"
          }
        }
      }
    },
    "不支持导入此项目（符号链接或特殊文件）：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item cannot be imported (symbolic link or special file): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持导入此项目（符号链接或特殊文件）：%@"
          }
        }
      }
    },
    "不能删除压缩包中的全部内容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can’t delete everything in the archive"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不能删除压缩包中的全部内容"
          }
        }
      }
    },
    "代理类型不匹配": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Proxy type mismatch"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理类型不匹配"
          }
        }
      }
    },
    "修改后的压缩包校验未通过，原压缩包未改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The edited archive failed verification; the original archive is unchanged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改后的压缩包校验未通过，原压缩包未改动"
          }
        }
      }
    },
    "修改日期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date Modified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改日期"
          }
        }
      }
    },
    "写入剪贴板失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t write to the clipboard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入剪贴板失败"
          }
        }
      }
    },
    "写入压缩包失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t write the archive: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入压缩包失败：%@"
          }
        }
      }
    },
    "写入设置失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t save settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写入设置失败"
          }
        }
      }
    },
    "分卷压缩包（%@）请在所在文件夹的预览中展开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To browse this multi-volume archive (%@), expand it from a preview of its folder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分卷压缩包（%@）请在所在文件夹的预览中展开"
          }
        }
      }
    },
    "创建日期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date Created"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建日期"
          }
        }
      }
    },
    "删除失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t delete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除失败"
          }
        }
      }
    },
    "压缩包中有重复路径，为避免损坏按只读处理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive contains duplicate paths, so it’s treated as read-only to avoid damage"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包中有重复路径，为避免损坏按只读处理"
          }
        }
      }
    },
    "压缩包在修改期间被其他程序更改，已放弃本次修改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive was changed by another app during the edit, so the change was discarded"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包在修改期间被其他程序更改，已放弃本次修改"
          }
        }
      }
    },
    "压缩包已被其他程序修改，请关闭预览后重新打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive was changed by another app. Close the preview and open it again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包已被其他程序修改，请关闭预览后重新打开"
          }
        }
      }
    },
    "压缩包或所在文件夹不可写": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The archive or its folder isn’t writable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "压缩包或所在文件夹不可写"
          }
        }
      }
    },
    "只能修改 ZIP 压缩包": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only ZIP archives can be modified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能修改 ZIP 压缩包"
          }
        }
      }
    },
    "只能修改本机内置磁盘上的压缩包（iCloud、网络与外置磁盘不支持原地修改）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only archives on this Mac’s internal disk can be modified (iCloud, network and external disks aren’t supported)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能修改本机内置磁盘上的压缩包（iCloud、网络与外置磁盘不支持原地修改）"
          }
        }
      }
    },
    "名称不能为空，也不能包含“/”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name can’t be empty or contain “/”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称不能为空，也不能包含“/”"
          }
        }
      }
    },
    "后台服务不可用：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background service unavailable: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台服务不可用：%@"
          }
        }
      }
    },
    "含签名的归档不支持修改": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signed archives cannot be modified"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "含签名的归档不支持修改"
          }
        }
      }
    },
    "大小": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大小"
          }
        }
      }
    },
    "密码不正确": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Incorrect password"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密码不正确"
          }
        }
      }
    },
    "尺寸": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimensions"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尺寸"
          }
        }
      }
    },
    "已取消，原压缩包未改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelled. The original archive was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消，原压缩包未改动"
          }
        }
      }
    },
    "已存在名为“%@”的项目": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item named “%@” already exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已存在名为“%@”的项目"
          }
        }
      }
    },
    "归档内找不到：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not found in archive: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "归档内找不到：%@"
          }
        }
      }
    },
    "打开主应用失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open PeekBox"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开主应用失败"
          }
        }
      }
    },
    "打开文件失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t open the file"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开文件失败"
          }
        }
      }
    },
    "提取失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraction failed"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提取失败"
          }
        }
      }
    },
    "无法创建 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建 %@"
          }
        }
      }
    },
    "无法创建解压器": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t create the decompressor"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法创建解压器"
          }
        }
      }
    },
    "无法在 Finder 中显示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t show in Finder"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在 Finder 中显示"
          }
        }
      }
    },
    "无法识别的压缩包：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrecognized archive: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法识别的压缩包：%@"
          }
        }
      }
    },
    "暂不支持向加密 ZIP 添加内容": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding content to encrypted ZIP archives is not supported yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂不支持向加密 ZIP 添加内容"
          }
        }
      }
    },
    "条目大小异常，压缩包可能已损坏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An entry has an invalid size; the archive may be damaged"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目大小异常，压缩包可能已损坏"
          }
        }
      }
    },
    "标签": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签"
          }
        }
      }
    },
    "格式无法识别（%d）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrecognized format (%d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "格式无法识别（%d）"
          }
        }
      }
    },
    "没有回复": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No reply"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有回复"
          }
        }
      }
    },
    "注释": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comments"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注释"
          }
        }
      }
    },
    "添加日期": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Date Added"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日期"
          }
        }
      }
    },
    "源文件在读取期间发生变化，已放弃导入：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file changed while being read. Import was abandoned: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "源文件在读取期间发生变化，已放弃导入：%@"
          }
        }
      }
    },
    "目标已存在：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Destination already exists: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标已存在：%@"
          }
        }
      }
    },
    "磁盘可用空间不足，原压缩包未改动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough disk space. The original archive was not changed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "磁盘可用空间不足，原压缩包未改动"
          }
        }
      }
    },
    "种类": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kind"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "种类"
          }
        }
      }
    },
    "移到废纸篓失败": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t move to Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓失败"
          }
        }
      }
    },
    "解压失败（XAD 错误 %d）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraction failed (XAD error %d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解压失败（XAD 错误 %d）"
          }
        }
      }
    },
    "解析失败（XAD 错误 %d）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the archive (XAD error %d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解析失败（XAD 错误 %d）"
          }
        }
      }
    },
    "读取压缩包失败：%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the archive: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取压缩包失败：%@"
          }
        }
      }

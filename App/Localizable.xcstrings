    "PeekBox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox"
          }
        }
      }
    },
    "PeekBox 只在你点击“检查更新…”时联网，不自动检查，不收集任何数据。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox connects to the internet only when you click “Check for Updates…”. It never checks automatically and collects no data."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox 只在你点击“检查更新…”时联网，不自动检查，不收集任何数据。"
          }
        }
      }
    },
    "PeekBox 采用 GPL-3.0 许可。本应用及第三方组件的许可原文随应用附带。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox is licensed under GPL-3.0. License texts for the app and its third-party components are included with the app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "PeekBox 采用 GPL-3.0 许可。本应用及第三方组件的许可原文随应用附带。"
          }
        }
      }
    },
    "“%@”中已有同名项目。替换会把原有的“%@”移到废纸篓。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An item with the same name already exists in “%1$@”. Replacing it moves the existing “%2$@” to the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”中已有同名项目。替换会把原有的“%@”移到废纸篓。"
          }
        }
      }
    },
    "“%@”已存在": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” already exists"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”已存在"
          }
        }
      }
    },
    "一切就绪。在 Finder 中选中文件夹或压缩包，按空格即可预览。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set. Select a folder or archive in Finder and press Space to preview it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切就绪。在 Finder 中选中文件夹或压缩包，按空格即可预览。"
          }
        }
      }
    },
    "下载": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads"
          }
        },
        "zh-Hans": {
